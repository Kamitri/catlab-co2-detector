{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CO2 Monitor",
  "version": "0.1.0",
  "identifier": "com.catlab.co2monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CO₂ Monitor",
        "width": 1400,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CATlab",
    "copyright": "© 2026 Nguyễn Minh Trí. All rights reserved.",
    "shortDescription": "CO₂ NDIR detector monitor"
  }
}